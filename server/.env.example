# MOTOSEC 237 v0.1 — À REMPLIR (copier vers .env, ne jamais commiter le .env).
# Aucune valeur réelle n'est fournie ici : remplacez chaque À_REMPLIR.
DATABASE_URL=sqlite:///./motosec237.db
SECRET_KEY=À_REMPLIR_chaine_aleatoire_longue
MOTOSEC_PAIRING_CODE=À_REMPLIR_6_chiffres
ALLOWED_ORIGINS=https://votre-domaine.exemple
MOTOSEC_DEMO_OTP=0
PORT=8000
# GOOGLE MAPS (v0.2) : clé API Google CÔTÉ SERVEUR UNIQUEMENT, pour le
# proxy d'itinéraire routier GET /maps/route (API Directions). Ne JAMAIS
# mettre cette clé dans l'appli Flutter. Dans Google Cloud, restreindre
# cette clé à l'API Directions. Sans elle, /maps/route répond 503 et
# l'appli retombe sur la ligne droite. Voir docs/GOOGLE-MAPS.md.
# (La clé de la CARTE Android, elle, reste dans app/android/local.properties.)
GOOGLE_MAPS_API_KEY=À_REMPLIR_cle_serveur_directions
